{
  "inputs": [
    {
      "id": "testrail-api-key-v2",
      "type": "promptString",
      "description": "Enter your TestRail API key (required; do not leave blank)",
      "password": true
    }
  ],
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.85"]
    },
    "testrail": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "--package", "@uarlouski/testrail-mcp-server@3.3.1", "testrail-mcp-server"],
      "env": {
        "TESTRAIL_INSTANCE_URL": "https://bmadtesttharushikar.testrail.io",
        "TESTRAIL_USERNAME": "tharushikar@verdentra.com",
        "TESTRAIL_API_KEY": "${input:testrail-api-key-v2}"
      }
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp"
    }
  }
}
