TEST_ENV=local
BASE_URL=https://todomvc.com/examples/react/dist/
API_URL=

# --- TestRail (results + test case sync; leave blank to disable) ---
# Same variable names as the TestRail MCP server, so one .env serves both.
# Copy this file to .env (gitignored) and put the API key ONLY there; never commit a real key here.
TESTRAIL_INSTANCE_URL=https://bmadtesttharushikar.testrail.io
TESTRAIL_USERNAME=tharushikar@verdentra.com
TESTRAIL_API_KEY=DDFJ7Id/UhLlY5CWFUAf-YykE9wqGfIH7miRbKw7R
TESTRAIL_PROJECT_ID=1
# Only needed when the project uses multiple test suites.
TESTRAIL_SUITE_ID=1
TESTRAIL_SECTION_NAME=Test-Tharushika
# Reuse an existing run instead of creating one per execution.
TESTRAIL_RUN_ID=
TESTRAIL_RUN_NAME=
#TESTRAIL_CLOSE_RUN=false
# Status ids: 1 passed, 2 blocked, 4 retest, 5 failed. Skipped tests stay untested unless set.
#TESTRAIL_SKIPPED_STATUS_ID=
#TESTRAIL_FLAKY_STATUS_ID=4
# Set to false to keep credentials but pause syncing.
TESTRAIL_ENABLED=true
# Set to true to fail the Playwright run when results did not land in a TestRail run.
TESTRAIL_REQUIRED=true

# --- Jira Cloud (defect creation on failure; leave blank to disable) ---
# The Jira site URL (REST v3 lives under it), not the Atlassian MCP endpoint.
JIRA_BASE_URL=https://carbon-hub-test.atlassian.net
JIRA_EMAIL=tharushikar@verdentra.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=C-HUB
JIRA_ISSUE_TYPE=Bug
JIRA_LABELS=automated-test,playwright
JIRA_ENABLED=true

# Optional link back to the pipeline; derived from GitHub Actions variables when unset.
CI_RUN_URL=
