TEST_ENV=local
BASE_URL=https://todomvc.com/examples/react/dist/
API_URL=
# Failed tests are retried this many times before they count as failed (default 3 → up to 4 runs).
PW_RETRIES=3

# --- TestRail (results + test case sync; leave blank to disable) ---
# Same variable names as the TestRail MCP server, so one .env serves both.
# Copy this file to .env (gitignored) and put the API key ONLY there; never commit a real key here.
TESTRAIL_INSTANCE_URL=https://bmadtesttharushikar.testrail.io
TESTRAIL_USERNAME=tharushikar@verdentra.com
TESTRAIL_API_KEY=
TESTRAIL_PROJECT_ID=3
# Only needed when the project uses multiple test suites.
TESTRAIL_SUITE_ID=10
TESTRAIL_SECTION_NAME=Automation Test Suite
# Reuse an existing run instead of creating one per execution.
TESTRAIL_RUN_ID=
TESTRAIL_RUN_NAME=
#TESTRAIL_CLOSE_RUN=false
# Status ids: 1 passed, 2 blocked, 4 retest, 5 failed. Skipped tests stay untested unless set.
#TESTRAIL_SKIPPED_STATUS_ID=
#TESTRAIL_FLAKY_STATUS_ID=4
# Set to false to keep credentials but pause syncing.
TESTRAIL_ENABLED=true
# Set to true to fail the Playwright run when results did not land in a TestRail run.
TESTRAIL_REQUIRED=true

# --- Jira Cloud (defect creation on failure; leave blank to disable) ---
# The Jira site URL (REST v3 lives under it), not the Atlassian MCP endpoint.
JIRA_BASE_URL=https://tharushikarverdentratest.atlassian.net/
# Must be the email of the Atlassian account that owns the token; a token from another account gives HTTP 401.
JIRA_EMAIL=tharushikarverdentra@gmail.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens while signed in as JIRA_EMAIL.
# Classic (unscoped) tokens and scoped tokens (read:jira-user, read:jira-work, write:jira-work) both work;
# tokens expire on the date chosen at creation. Put the value ONLY in .env — a token committed here is
# revoked by Atlassian automatically and the reporter warns when it finds one.
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM
JIRA_ISSUE_TYPE=Bug
JIRA_LABELS=Automation,Playwright
# Custom field that receives the Severity level (id like customfield_10040, or its name). Defaults to the field named "Severity".
JIRA_SEVERITY_FIELD=
# A defect is raised only when a test failed on this many consecutive attempts (default 4 = 1 run + 3 retries).
# Keep it equal to PW_RETRIES + 1.
JIRA_MIN_FAILED_ATTEMPTS=4
JIRA_ENABLED=true

# --- Standard bug report fields (optional; derived automatically when blank) ---
# These land in the Jira "Environment" field together with TEST_ENV (Tested Environment) and BASE_URL (Tested URL).
# Release No.: defaults to "<package.json version>+<short git sha>" (GITHUB_SHA / CI_COMMIT_SHA in CI).
RELEASE_NO=
# Tested Devices: defaults to "<project>: <viewport> desktop|mobile on <OS> (<arch>)".
TESTED_DEVICES=
# Tested Browsers: defaults to the bundled browser and its version, e.g. "Chromium 158.0.8127.18".
TESTED_BROWSERS=

# Optional link back to the pipeline; derived from GitHub Actions variables when unset.
CI_RUN_URL=
